APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://slowtalk:slowtalk@localhost:5432/slowtalk
API_PREFIX=/api/v1
# Browser clients only: JSON array of permitted origins, for example
# CORS_ORIGINS=["https://your-frontend.up.railway.app"]
CORS_ORIGINS=[]
JWT_SECRET=local-development-secret-change-before-deploy
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_CHAT_MODEL=
UPSTAGE_EMBEDDING_MODEL=solar-embedding-2
EMBEDDING_DIMENSIONS=1024
# MATCH_MIN_SIMILARITY must be set before shadow or enforce matching is enabled.
# MATCH_MIN_SIMILARITY=0.70
MATCHING_MODE=disabled
MODERATION_MODE=disabled
ALLOW_DEVELOPMENT_MODERATION_FALLBACK=false
MODERATION_ALLOW_CONFIDENCE=0.7
MODERATION_BLOCK_CONFIDENCE=0.9
MODERATION_ENCRYPTION_KEY=
CONTENT_HASH_PEPPER=
INTERNAL_MODERATION_TOKEN=
